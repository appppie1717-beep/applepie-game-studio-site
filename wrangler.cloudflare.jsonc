{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "applepie-im-static",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
