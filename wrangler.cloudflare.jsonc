{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ersiyan-com-static",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ersiyan.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
